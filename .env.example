# ---- Banco (serviço Postgres do EasyPanel) ----
DATABASE_URL=postgres://usuario:senha@impulse_postgres:5432/impulse

# ---- Segurança ----
JWT_SECRET=troque-por-uma-string-longa-e-aleatoria
INTERNAL_API_KEY=chave-que-o-n8n-vai-usar
# Deixe true só no primeiro acesso, para criar sua conta. Depois volte para false.
ALLOW_SIGNUP=true

# ---- URLs ----
# Domínio público deste backend (o WAHA precisa alcançar para mandar o webhook)
PUBLIC_URL=https://crm.seudominio.com
# Onde o HTML busca a API. Se o backend serve o HTML, deixe /api.
API_BASE_URL=/api
# Restrinja se o HTML estiver em outro domínio
CORS_ORIGIN=*

# ---- Tenant inicial (seu primeiro cliente) ----
DEFAULT_TENANT_SLUG=principal
DEFAULT_TENANT_NAME=Cliente principal

# ---- WAHA deste cliente ----
# No WAHA Core cada cliente tem a própria instância. Use o nome do serviço no EasyPanel.
WAHA_URL=http://waha_cliente1:3000
WAHA_API_KEY=a-api-key-do-seu-waha
WAHA_SESSION=default

# ---- n8n (opcional) ----
# Se preenchido, o CRM repassa as mensagens recebidas para a automação.
N8N_WEBHOOK_URL=
